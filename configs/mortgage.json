{
  "inputs": {
    "tot": "Total Price of the House",
    "down": "Down Payment",
    "rate": "Interest Rate",
    "duration": "Duration (in years)",
    "hoa": "HOA/Strata Fees (Optional)",
    "rent": "Rent",
    "rent_increase_percentage": "Rent increase % (yearly)"
  },
  "constants": {
    "premium_5_down": 0.04,
    "premium_10_down": 0.031,
    "premium_15_down": 0.028,
    "premium_20_down": 0.024,
    "premium_25_down": 0.017,
    "premium_35_down": 0.006,
    "ptt_200k": 0.01,
    "ptt_2m": 0.02,
    "ptt_3m": 0.03,
    "ptt_3m_plus": 0.05,
    "ptt_cutoff_amt": 835000,
    "gst": 0.05,
    "gst_cutoff_amt": 1000000,
    "property_tax_rate": 0.003
  },
  "intermediates": {
    "loan_amt": "tot - down",
    "loan_ratio": "loan_amt / tot",
    "mortgage_insurance": "loan_ratio > 0.90 ? premium_5_down * loan_amt : loan_ratio > 0.85 ? premium_10_down * loan_amt : loan_ratio > 0.80 ? premium_15_down * loan_amt : loan_ratio > 0.75 ? premium_20_down * loan_amt : loan_ratio > 0.65 ? premium_25_down * loan_amt : premium_35_down * loan_amt",
    "loan_amt_post_insurance": "loan_amt + mortgage_insurance",
    "emi_monthly_rate": "(rate / 100) / 12",
    "emi_numerator": "loan_amt_post_insurance * emi_monthly_rate * Math.pow(1 + emi_monthly_rate, duration * 12)",
    "emi_denominator": "Math.max(Math.pow(1 + emi_monthly_rate, duration * 12) - 1, 0.009)",
    "emi": "emi_numerator / emi_denominator",
    "gst_amt": "tot * gst",
    "ptt_200k_amt": "ptt_200k * (tot < 200000 ? tot : 200000)",
    "ptt_2m_amt": "ptt_200k_amt + ptt_2m * (tot < 2000000 ? Math.max(tot - 200000, 0) : 1800000)",
    "ptt_3m_amt": "ptt_2m_amt + ptt_3m * (tot < 3000000 ? Math.max(tot - 2000000, 0) : 1000000)",
    "ptt_amt": "ptt_3m_amt + ptt_3m_plus * Math.max(tot - 3000000, 0)",
    "gst_ptt": "gst_amt + ptt_amt",
    "gst_amt_fthb": "tot * gst - (tot < gst_cutoff_amt ? tot * gst : tot >= 1.5 * gst_cutoff_amt ? 0 : 50000 * (1 - ((tot - gst_cutoff_amt) * 2 / gst_cutoff_amt)))",
    "tot_for_fthb_ptt": "tot > ptt_cutoff_amt ? tot : Math.max(0, tot - 500000)",
    "ptt_200k_amt_fthb": "ptt_200k * (tot_for_fthb_ptt < 200000 ? tot_for_fthb_ptt : 200000)",
    "ptt_2m_amt_fthb": "ptt_200k_amt_fthb + ptt_2m * (tot_for_fthb_ptt < 2000000 ? Math.max(tot_for_fthb_ptt - 200000, 0) : 1800000)",
    "ptt_3m_amt_fthb": "ptt_2m_amt_fthb + ptt_3m * (tot_for_fthb_ptt < 3000000 ? Math.max(tot_for_fthb_ptt - 2000000, 0) : 1000000)",
    "ptt_amt_fthb": "ptt_3m_amt_fthb + ptt_3m_plus * Math.max(tot_for_fthb_ptt - 3000000, 0)",
    "gst_ptt_fthb": "gst_amt_fthb + ptt_amt_fthb",
    "property_tax": "property_tax_rate * tot",
    "total_monthly_cost": "emi + hoa + (property_tax / 12)",
    "total_one_time_cost": "down + gst_ptt",
    "total_one_time_cost": "down + gst_ptt_fthb",
    "total_loan_cost": "emi * 12 * duration",
    "break_even_appreciation": "(Math.pow((total_loan_cost + total_one_time_cost)/tot, 1/duration) - 1) * 100",
    "rent_increase_factor": "1 + (rent_increase_percentage / 100)",
    "rent_multiply_factor": "rent_increase_factor === 1 ? duration : (1 - Math.pow(rent_increase_factor, duration)) / (1 - rent_increase_factor)",
    "total_rent_paid": "rent_multiply_factor * rent * 12"
  },
  "outputs": {
    "gst_ptt": "GST + PTT (Paid on top of Down and EMI)",
    "gst_ptt_fthb": "GST + PTT (First Time Home Buyer)",
    "mortgage_insurance": "Mortgage Insurance",
    "emi": "EMI with mortgage insurance (Monthly)",
    "property_tax": "Property Tax per year (based on total price)",
    "total_monthly_cost": "Total monthly cost (incl. hoa and property tax)",
    "total_one_time_cost": "Total one-time cost",
    "total_one_time_cost": "Total one-time cost (First Time Home Buyer)",
    "total_loan_cost": "Total cost of the loan",
    "break_even_appreciation": "Yearly property appreciation (approx %) to break even",
    "total_rent_paid": "Total rent paid given your duration"
  }
}

