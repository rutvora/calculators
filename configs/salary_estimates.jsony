{
  "inputs": {
    "base": "Base (Yearly, CAD)",
    "bonus": "Bonus",
    "stock_units_rsu": "RSU Stock Units Per Year",
    "curr_stock_price": "Current Stock Price (USD)",
    "stock_price_fluctuation_percentage": "% Expected Stock Price Fluctuation",
    "espp_contrib_percent": "% Contribution to ESPP (from base)",
    "espp_offer_price": "ESPP Offer Price (USD)",
    "exchange_rate": "1 USD = X CAD (Enter X)"
  },
  "constants": {
    "C1": 10
  },
  "intermediates": {
    "fluctuation": "stock_price_fluctuation_percentage / 100",
    "stock_price_min": "(curr_stock_price * (1 - fluctuation))",
    "stock_price_max": "(curr_stock_price * (1 + fluctuation))",
    "exchange_rate": "exchange_rate == 0 ? 1 : exchange_rate",
    "espp_offer_price": "espp_offer_price == 0 ? 1 : espp_offer_price",
    "stock_units_espp": "(base / exchange_rate) * (espp_contrib_percent / 100) / espp_offer_price",
    "stock_units_all": "stock_units_rsu + stock_units_espp",
    "stocks_amt_min": "stock_price_min * stock_units_all * exchange_rate",
    "stocks_amt_max": "stock_price_max * stock_units_all * exchange_rate",
    "total_min": "stocks_amt_min + base_minus_espp_contrib + bonus",
    "total_max": "stocks_amt_max + base_minus_espp_contrib + bonus"
  },
  "outputs": {
    "stocks_amt_min": "Min Stock component",
    "stocks_amt_max": "Max Stock component",
    "total_min": "Min Yearly TC",
    "total_max": "Max yearly TC",
    "fluctuation": "stock_price_fluctuation_percentage / 100",
    "stock_price_min": "(curr_stock_price * (1 - fluctuation))",
    "stock_price_max": "(curr_stock_price * (1 + fluctuation))",
    "exchange_rate": "exchange_rate == 0 ? 1 : exchange_rate",
    "espp_offer_price": "espp_offer_price == 0 ? 1 : espp_offer_price",
    "stock_units_espp": "(base / exchange_rate) * (espp_contrib_percent / 100) / espp_offer_price",
    "stock_units_all": "stock_units_rsu + stock_units_espp",
    "stocks_amt_min": "stock_price_min * stock_units_all * exchange_rate",
    "stocks_amt_max": "stock_price_max * stock_units_all * exchange_rate",
    "total_min": "stocks_amt_min + base + bonus",
    "total_max": "stocks_amt_max + base + bonus",
    "base_minus_espp_contrib": "base * (1 - espp_contrib_percent / 100)"
  }
}

