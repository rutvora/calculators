{
  "inputs": {
    "amt": "Amount",
    "duration": "Duration (in years)",
    "emi_rate": "% Rate of Interest (EMI)",
    "investment_roi": "% Expected Rate of Return (Investment)"
  },
  "constants": {
  },
  "intermediates": {
    "emi_monthly_rate": "(emi_rate / 100) / 12",
    "emi_numerator": "amt * emi_monthly_rate * Math.pow(1 + emi_monthly_rate, duration * 12)",
    "emi_denominator": "Math.max(Math.pow(1 + emi_monthly_rate, duration * 12) - 1, 0.001)",
    "emi": "emi_numerator / emi_denominator",
    "emi_payment": "emi * duration * 12",
    "investment": "Math.pow(1 + investment_roi / 100, duration) * amt",
    "diff": "investment - emi_payment",
    "break_even_investment_roi": "(Math.pow(emi_payment / amt, 1/duration) - 1) * 100"
  },
  "outputs": {
    "emi": "Monthly EMI",
    "emi_payment": "Total EMI payment",
    "investment": "Returns from Investment",
    "diff": "Benefit/Loss from investing",
    "break_even_investment_roi": "% ROI to break even with investment"
  }
}
